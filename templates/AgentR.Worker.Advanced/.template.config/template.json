{
    "$schema": "http://json.schemastore.org/template",
    "author": "AgentR Contributors",
    "classifications": [
        "AI",
        "Agent",
        "SignalR",
        "Distributed",
        "Advanced"
    ],
    "identity": "AgentR.Worker.Advanced.Template",
    "name": "AgentR Worker (Advanced)",
    "shortName": "agentr-worker-advanced",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "sourceName": "AgentRWorkerAdvanced",
    "preferNameDirectory": true,
    "symbols": {
        "AgentName": {
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "MyAdvancedAgent",
            "replaces": "AGENT_NAME_PLACEHOLDER",
            "description": "The name of your agent"
        },
        "HubUrl": {
            "type": "parameter",
            "datatype": "string",
            "defaultValue": "http://localhost:5000/agentHub",
            "replaces": "HUB_URL_PLACEHOLDER",
            "description": "The SignalR hub URL to connect to"
        }
    }
}
