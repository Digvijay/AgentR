    }

    .log-entry.writer { border-color: #00ff88; }
    .log-entry.reviewer { border-color: #e3b341; }
    .log-entry.tester { border-color: #00d4ff; }
    .log-entry.system { border-color: #8b949e; opacity: 0.8; }

    .sim-badge {
        font-size: 0.7rem;
        background: #1f6feb;
        color: white;
        padding: 2px 6px;
        border-radius: 10px;
        margin-right: 0.8rem;
        font-weight: 600;
    }

    .timestamp { color: #8b949e; margin-right: 1rem; font-size: 0.8rem; min-width: 70px; }
    .agent-name { font-weight: bold; margin-right: 1rem; color: #e6edf3; min-width: 90px; }
    .message { color: #d0d7de; }

    .result-section {
        margin-top: 3rem;
        padding: 2rem;
        background: rgba(35, 134, 54, 0.1);
        border: 1px solid rgba(35, 134, 54, 0.4);
        border-radius: 12px;
    }

    .result-section h3 { color: #3fb950; margin-bottom: 1rem; font-size: 1.2rem; }

    .result-section pre {
        background: #0d1117;
        padding: 1.5rem;
        border-radius: 8px;
        overflow-x: auto;
        border: 1px solid #30363d;
        color: #e6edf3;
        font-family: 'JetBrains Mono', monospace;
    }

    .test-results {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px dashed rgba(35, 134, 54, 0.4);
    }
    .test-results h4 { color: #e6edf3; margin-bottom: 1rem; }
    .test-results pre { border-color: rgba(35, 134, 54, 0.4); }
</style>
