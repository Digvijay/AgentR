@page "/replay"
@using AgentR.Shared
@using AgentR.Demo.Web.Auditing
@inject AuditClient AuditClient
@rendermode InteractiveServer

<PageTitle>Session Replay</PageTitle>

<div class="replay-container">
    <h1>📼 Session Replay</h1>
    <p>Enter a Room ID to watch the conversation replay millisecond by millisecond.</p>

    <div class="search-box">
        <input @bind="roomId" placeholder="Enter Room ID (e.g., test-room)" @onkeyup="HandleKeyUp" />
        <button @onclick="LoadReplay" disabled="@isLoggingIn">Fetch from Hub</button>
    </div>

    <div class="paste-section">
        <textarea @bind="pastedJson" placeholder="OR Paste raw JSON from Code Review Demo..."></textarea>
        <div class="button-group">
            <button @onclick="LoadPasted">🎞️ Load Manual Log</button>
            <button class="secondary" @onclick="LoadSample">🍿 Load Sample Data</button>
        </div>
    </div>

    @if (records != null)
    {
        <div class="replay-controls">
            <button @onclick="Play" disabled="@isPlaying">▶️ Play</button>
            <button @onclick="Pause" disabled="@(!isPlaying)">⏸️ Pause</button>
            <button @onclick="Reset">🔄 Reset</button>
            <span class="status">Step: @currentIndex / @records.Count</span>
        </div>

        <div class="log-viewer">
            @foreach (var record in displayedRecords)
            {
                <div class="log-entry @record.EventType.ToLower()">
                    <span class="time">@record.Timestamp.ToString("HH:mm:ss.fff")</span>
                    <span class="agent">@record.AgentId</span>
                    <span class="event">@record.EventType</span>
                    <span class="content">@record.Content</span>
                </div>
            }
        </div>
    }
    else if (isLoggingIn)
    {
        <p>Loading logs...</p>
    }
</div>

@code {
    private string roomId = "code-review-demo-room";
    private string pastedJson = "";
    private List<AuditRecord>? records;
    private List<AuditRecord> displayedRecords = new();
    private int currentIndex = 0;
    private bool isPlaying = false;
    private bool isLoggingIn = false;

    private void LoadPasted()
    {
        if (string.IsNullOrWhiteSpace(pastedJson)) return;
        try
        {
            records = System.Text.Json.JsonSerializer.Deserialize<List<AuditRecord>>(pastedJson);
            displayedRecords.Clear();
            currentIndex = 0;
            isPlaying = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Invalid JSON: {ex.Message}");
        }
    }

    private void LoadSample()
    {
        pastedJson = @"
[
  { ""AgentId"": ""writer"", ""Content"": ""Designing solution for user task..."", ""EventType"": ""Thinking"", ""Timestamp"": ""2023-11-14T22:13:21.000+00:00"" },
  { ""AgentId"": ""writer"", ""Content"": ""REVIEW_REQUEST: ```csharp\npublic int Add(int a, int b) => a + b;\n```"", ""EventType"": ""MessageFrame"", ""Timestamp"": ""2023-11-14T22:13:22.000+00:00"" },
  { ""AgentId"": ""reviewer"", ""Content"": ""Checking for syntax errors and style guide compliance..."", ""EventType"": ""Thinking"", ""Timestamp"": ""2023-11-14T22:13:24.000+00:00"" },
  { ""AgentId"": ""reviewer"", ""Content"": ""TEST_REQUEST: Code looks good. Prepare unit tests."", ""EventType"": ""MessageFrame"", ""Timestamp"": ""2023-11-14T22:13:26.000+00:00"" },
  { ""AgentId"": ""tester"", ""Content"": ""Compiling and running NUnit test suite..."", ""EventType"": ""Thinking"", ""Timestamp"": ""2023-11-14T22:13:28.000+00:00"" },
  { ""AgentId"": ""tester"", ""Content"": ""Test Results:\n✅ Passes (3/3)\n🏁 WORKFLOW_COMPLETE"", ""EventType"": ""MessageFrame"", ""Timestamp"": ""2023-11-14T22:13:30.000+00:00"" }
]";
        LoadPasted();
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _ = LoadReplay();
        }
    }

    private async Task LoadReplay()
    {
        isLoggingIn = true;
        records = null;
        displayedRecords.Clear();
        currentIndex = 0;
        isPlaying = false;
        
        try
        {
            records = await AuditClient.GetReplayAsync(roomId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading logs: {ex.Message}");
        }
        finally
        {
            isLoggingIn = false;
        }
    }

    private async Task Play()
    {
        if (records == null || isPlaying) return;
        isPlaying = true;

        while (isPlaying && currentIndex < records.Count)
        {
            var current = records[currentIndex];
            displayedRecords.Insert(0, current); // Show newest at top
            if (displayedRecords.Count > 50) displayedRecords.RemoveAt(50);
            
            currentIndex++;
            StateHasChanged();

            // Simulate timing
            if (currentIndex < records.Count)
            {
                var next = records[currentIndex];
                var delay = (int)(next.Timestamp - current.Timestamp).TotalMilliseconds;
                await Task.Delay(Math.Clamp(delay, 50, 1000));
            }
        }

        isPlaying = false;
    }

    private void Pause() => isPlaying = false;

    private void Reset()
    {
        isPlaying = false;
        currentIndex = 0;
        displayedRecords.Clear();
    }
}

<style>
    .replay-container { max-width: 900px; margin: 0 auto; padding: 20px; font-family: 'Inter', sans-serif; }
    .search-box { display: flex; gap: 10px; margin-bottom: 20px; }
    .search-box input { flex: 1; padding: 10px; border-radius: 8px; border: 1px solid #ccc; }
    .search-box button { padding: 10px 20px; border-radius: 8px; background: #6366f1; color: white; border: none; cursor: pointer; }
    
    .paste-section { margin-bottom: 2rem; display: flex; flex-direction: column; gap: 10px; }
    .paste-section textarea { 
        background: #0f172a; 
        color: #94a3b8; 
        border: 1px solid #1e293b; 
        border-radius: 8px; 
        padding: 0.8rem; 
        font-family: monospace; 
        font-size: 0.8rem;
        height: 60px;
        resize: vertical;
    }
    .button-group { display: flex; gap: 10px; }
    .paste-section button { 
        padding: 8px 16px; 
        background: #1e293b; 
        color: #94a3b8; 
        border: 1px solid #334155; 
        border-radius: 6px; 
        cursor: pointer; 
        font-weight: bold;
        flex: 1;
    }
    .paste-section button:hover { background: #334155; color: white; }
    .paste-section button.secondary { background: #0d1117; border-color: #30363d; color: #58a6ff; }
    .paste-section button.secondary:hover { background: #1f2937; }

    .replay-controls { margin-bottom: 20px; display: flex; gap: 10px; align-items: center; }
    .replay-controls button { padding: 8px 16px; border-radius: 6px; border: 1px solid #ddd; background: #f9fafb; cursor: pointer; }
    .status { font-size: 0.9rem; color: #666; }

    .log-viewer { background: #1e293b; color: #f8fafc; padding: 20px; border-radius: 12px; height: 500px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; }
    .log-entry { font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; padding: 8px; border-radius: 4px; display: flex; gap: 15px; border-left: 4px solid transparent; }
    
    .log-entry.thinkingframe { border-left-color: #fbbf24; background: rgba(251, 191, 36, 0.1); }
    .log-entry.messageframe { border-left-color: #10b981; background: rgba(16, 185, 129, 0.1); }
    .log-entry.turnrequested { border-left-color: #6366f1; background: rgba(99, 102, 241, 0.1); }
    .log-entry.interruptframe { border-left-color: #ef4444; background: rgba(239, 68, 68, 0.1); }

    .time { color: #94a3b8; min-width: 100px; }
    .agent { color: #38bdf8; font-weight: bold; min-width: 100px; }
    .event { color: #f472b6; min-width: 120px; }
    .content { flex: 1; word-break: break-all; }
</style>
