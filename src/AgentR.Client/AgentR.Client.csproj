<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentR.Shared\AgentR.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <PackageId>AgentR.Client</PackageId>
    <PackageId>AgentR.Client</PackageId>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>NuGetREADME.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Digvijay/AgentR</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Digvijay/AgentR</RepositoryUrl>
    <Description>The high-performance C# SDK for the AgentR Real-time Transport Protocol. Enables distributed AI agents with mutual exclusion and remote interruptibility.</Description>
    <PackageTags>ai;agents;signalr;distributed;concurrency;messaging;messagepack</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Official v1.0.0 Release: Python Interop, Project Templates, and stable Redis Locking.</PackageReleaseNotes>
    
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\NuGetREADME.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
